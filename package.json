{
  "name": "copilot-review-assistant",
  "displayName": "Copilot Review Assistant",
  "description": "Send code snippets and review plans to Copilot Chat seamlessly via inline comments.",
  "publisher": "morganqin",
  "author": "Morgan Qin",
  "version": "1.2.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotReview.createReviewThread",
        "title": "Add Comment to Copilot",
        "icon": "$(comment-add)"
      },
      {
        "command": "copilotReview.addDraft",
        "title": "Add Draft"
      },
      {
        "command": "copilotReview.cancelDraft",
        "title": "Cancel"
      },
      {
        "command": "copilotReview.submitDrafts",
        "title": "Submit Drafts to Copilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "copilotReview.deleteDraft",
        "title": "Delete Draft",
        "icon": "$(trash)"
      },
      {
        "command": "copilotReview.editDraft",
        "title": "Edit Draft",
        "icon": "$(edit)"
      },
      {
        "command": "copilotReview.saveDraftEdit",
        "title": "Update Draft"
      },
      {
        "command": "copilotReview.cancelDraftEdit",
        "title": "Cancel"
      },
      {
        "command": "copilotReview.clearAllDrafts",
        "title": "Clear All Drafts",
        "icon": "$(trash)"
      },
      {
        "command": "copilotReview.toggleViewGrouped",
        "title": "View as Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "copilotReview.toggleViewFlat",
        "title": "View as List",
        "icon": "$(list-flat)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-review-sidebar",
          "title": "REVIEW",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "copilot-review-sidebar": [
        {
          "id": "copilotReview.draftsView",
          "name": "DRAFT",
          "type": "webview",
          "contextualTitle": "Plan Review Drafts"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "copilotReview.createReviewThread",
          "group": "1_modification"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "copilotReview.addDraft",
          "group": "inline@1",
          "when": "commentThread != 'draft'"
        },
        {
          "command": "copilotReview.cancelDraft",
          "group": "inline@2",
          "when": "commentThread != 'draft'"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "copilotReview.editDraft",
          "group": "navigation@1",
          "when": "commentThread == 'draft'"
        },
        {
          "command": "copilotReview.deleteDraft",
          "group": "navigation@2",
          "when": "commentThread == 'draft'"
        }
      ],
      "comments/comment/title": [],
      "comments/comment/context": [
        {
          "command": "copilotReview.saveDraftEdit",
          "group": "inline@1",
          "when": "comment == 'draftEditing'"
        },
        {
          "command": "copilotReview.cancelDraftEdit",
          "group": "inline@2",
          "when": "comment == 'draftEditing'"
        }
      ],
      "view/title": [
        {
          "command": "copilotReview.submitDrafts",
          "when": "view == 'copilotReview.draftsView'",
          "group": "navigation@1"
        },
        {
          "command": "copilotReview.toggleViewGrouped",
          "when": "view == 'copilotReview.draftsView' && !copilotReview.viewGrouped",
          "group": "navigation@2"
        },
        {
          "command": "copilotReview.toggleViewFlat",
          "when": "view == 'copilotReview.draftsView' && copilotReview.viewGrouped",
          "group": "navigation@2"
        },
        {
          "command": "copilotReview.clearAllDrafts",
          "when": "view == 'copilotReview.draftsView'",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "copilotReview.submitDrafts",
          "when": "copilotReview.hasDrafts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "copilotReview.deleteDraft",
          "when": "view == 'copilotReview.draftsView'",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Review Assistant",
      "properties": {
        "copilotReview.promptStyle": {
          "type": "string",
          "enum": ["concise", "detailed"],
          "default": "concise",
          "enumDescriptions": [
            "Concise: File references with comments only, no inline code",
            "Detailed: Includes full code blocks with comments"
          ],
          "markdownDescription": "Default prompt style for submitting to Copilot Chat. Can also be changed per-submission in the Submit panel."
        },
        "copilotReview.codePreviewMaxLines": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "maximum": 20,
          "markdownDescription": "Max lines of code to show in the submit preview panel (0-20). Snippets longer than this are truncated with an ellipsis."
        }
      }
    },
    "keybindings": [
      {
        "command": "copilotReview.createReviewThread",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorHasSelection"
      },
      {
        "command": "copilotReview.submitDrafts",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "copilotReview.hasDrafts"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package -o release/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.3",
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.49.0",
    "mocha": "^10.2.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  }
}
